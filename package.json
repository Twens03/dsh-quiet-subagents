{
  "name": "dsh-quiet-subagents",
  "version": "0.2.1",
  "private": true,
  "description": "Session-scoped, manually armed quiet mode for direct subagent messages in DeepSeek Harness: one human-readable QueueDock bubble per child, settled refreshes the same item, then quiet mode turns itself off.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "client/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "readme/*.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "quiet",
    "inbox"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
